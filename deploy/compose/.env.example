# Self-hosted Convex stack: copy to .env next to docker-compose.yml (gitignored, mode 600) and fill in.
# Register these names in TOKENS.md ("Self-hosted stack"). Never commit values.

# --- Compose project (lowercase letters, digits, dashes) ---
COMPOSE_PROJECT_NAME=

# --- Postgres (bundled service) ---
POSTGRES_USER=convex
# Random, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
# Must equal INSTANCE_NAME with "-" replaced by "_"
POSTGRES_DB=convex_self_hosted

# --- Convex backend ---
INSTANCE_NAME=convex-self-hosted
# Random 32-byte hex: `openssl rand -hex 32`. Changing it invalidates every admin key.
INSTANCE_SECRET=
# Leave empty to use the bundled postgres service. For managed Postgres: the connection
# string WITHOUT the database name, and set DO_NOT_REQUIRE_SSL= (empty; any value means "on").
POSTGRES_URL=
DO_NOT_REQUIRE_SSL=1
# 1 = server error details are hidden from clients. Keep 1 on every public VM (test and production).
# Only the laptop .env may set it empty (REDACT_LOGS_TO_CLIENT=) so e2e sees server error messages.
REDACT_LOGS_TO_CLIENT=1
# Query/mutation user-time limit in seconds (Convex Cloud: 1). Keep 1.
DATABASE_UDF_USER_TIMEOUT_SECONDS=1
# Public origins. Laptop: http://127.0.0.1:<port>. Public VM: https://<api domain>, https://<site domain>.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3410
CONVEX_SITE_ORIGIN=http://127.0.0.1:3411
# Origin the dashboard (in the operator's browser) talks to.
DASHBOARD_DEPLOYMENT_URL=http://127.0.0.1:3410

# --- Image tags (pinned; bump backend and dashboard together) ---
CONVEX_BACKEND_TAG=5e677d76314a1bab5d0f70816e6dda8d5e824794
CONVEX_DASHBOARD_TAG=5e677d76314a1bab5d0f70816e6dda8d5e824794

# --- Host ports and bind address ---
# 127.0.0.1 keeps everything on loopback (laptop, and a public VM behind Caddy).
BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=3410
SITE_HOST_PORT=3411
DASHBOARD_HOST_PORT=6792
POSTGRES_HOST_PORT=5442

# --- HTTPS profile (public VM only: `--profile https`) ---
HTTPS_BIND_ADDRESS=0.0.0.0
CONVEX_API_DOMAIN=
CONVEX_SITE_DOMAIN=
CONVEX_DASHBOARD_DOMAIN=
ACME_EMAIL=
