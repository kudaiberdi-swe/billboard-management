# Names only. Copy to .env.local (gitignored) and fill in. Values never go into git.
# Self-hosted laptop stack (deploy/compose/README.md): backend on 127.0.0.1:3410.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
VITE_CONVEX_URL=
# Password the e2e smoke test types into the password screen (same value as the Convex env DEMO_PASSWORD).
E2E_DEMO_PASSWORD=
